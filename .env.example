# Copy to .env.local and fill in. Never commit real values.
# Fastest way to populate: `vercel env pull .env.local`

# --- Required ---
# Neon Postgres connection string (pooled)
DATABASE_URL=

# Better Auth signing secret, >= 32 chars. Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=

# --- Optional ---
# Canonical auth base URL. Leave empty locally; the app falls back to http://localhost:3000
BETTER_AUTH_URL=

# Canonical public site URL used for SEO metadata
NEXT_PUBLIC_SITE_URL=

# Shared secret that unlocks test-mode clue access outside development
PYTHEA_TEST_KEY=

# Google Apps Script notification webhook
APPS_SCRIPT_WEBHOOK_URL=
APPS_SCRIPT_SECRET=

# Search console verification tokens
GOOGLE_SITE_VERIFICATION=
BING_SITE_VERIFICATION=

# --- Migration scripts only (migration/*.mjs) ---
SOURCE_DATABASE_URL=
TARGET_DATABASE_URL=
SOURCE_BLOB_TOKEN=
TARGET_BLOB_TOKEN=
